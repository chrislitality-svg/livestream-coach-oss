# ─────────────────────────────────────────────────────────────
# 复制为 config/.env.local 后填写（.env.local 不入库）。
# 也可以跑交互式向导：python scripts/configure.py
# 进程环境变量优先于这个文件。
# ─────────────────────────────────────────────────────────────

# ── 大模型（深度语义分析、轮次切分、视觉量化、方法论）────────
# 任何兼容 OpenAI Chat Completions 接口的服务都可以：
#   阿里云百炼  https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-max / qwen-vl-max
#   DeepSeek    https://api.deepseek.com/v1                         deepseek-chat（无视觉模型）
#   OpenAI      https://api.openai.com/v1                           gpt-4o / gpt-4o
#   Ollama 本地 http://localhost:11434/v1                           qwen2.5:14b / qwen2.5vl:7b
# 都不填、也没有 DASHSCOPE_API_KEY = 只跑规则层（话术结构、促单空窗、弹幕意图等），模型层自动跳过，
# 服务恢复后 auto_analyze 会自动补跑。
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEXT_MODEL=
LLM_VL_MODEL=

# ── 语音转写 ──────────────────────────────────────────────────
# nano   本地 CPU（FunASR-Nano + sherpa-onnx），默认，无需密钥、无需显卡
# local  本地 faster-whisper（建议有 NVIDIA 显卡），pip install faster-whisper
# aliyun 阿里云录音识别（要 DASHSCOPE_API_KEY），pip install dashscope
# 全库必须用同一个引擎；换引擎后用 scripts/retranscribe.py 全库重转
ASR_ENGINE=nano

# 只有 ASR_ENGINE=aliyun 才需要
DASHSCOPE_API_KEY=
ASR_MODEL=qwen-audio-3.0-asr-flash

# ── 本地模型目录（可选）──────────────────────────────────────
# 不填就用 models/ 下的默认目录。下载：python scripts/setup_models.py
# 可以写绝对路径，也可以写相对项目根目录的路径
NANO_MODEL_DIR=
PUNCT_MODEL_DIR=
